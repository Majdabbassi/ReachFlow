# Copy to .env (git-ignored). Everything is optional: the defaults work for a local run.

# Database
MYSQL_ROOT_PASSWORD=root

# AES key that encrypts the stored Gmail app passwords. Change it before storing real ones.
ENCRYPTION_KEY=change-me-to-a-long-random-string

# Host ports (all bound to 127.0.0.1). Change them if they clash with another project.
FRONTEND_HOST_PORT=8088
BACKEND_HOST_PORT=8082
MYSQL_HOST_PORT=3306
PHPMYADMIN_HOST_PORT=5051
N8N_HOST_PORT=5678

# Demo mode only (docker-compose.demo.yml)
MAILHOG_UI_HOST_PORT=8025
MOCK_DELAY_SECONDS=4
