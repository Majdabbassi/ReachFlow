      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const website = item.json.website;\n  if (!website) {\n    results.push({\n      json: {\n        title: item.json.title || '',\n        city: item.json.city || '',\n        phone: item.json.phone || '',\n        website: '',\n        address: item.json.address || '',\n        email: null,\n        allEmails: []\n      }\n    });\n    continue;\n  }\n  const base = website.replace(/\\/$/, '');\n  const urls = [\n    base + '/impressum',\n    base,\n    base + '/kontakt',\n    base + '/contact'\n  ];\n  let allEmails = [];\n  for (const url of urls) {\n    try {\n      const response = await this.helpers.httpRequest({\n        method: 'GET',\n        url,\n        timeout: 5000,\n        headers: {\n          'User-Agent': 'Mozilla/5.0'\n        }\n      });\n      const html = typeof response === 'string' ? response : JSON.stringify(response);\n      const found = html.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/gi) || [];\n      allEmails.push(...found);\n    } catch (e) {}\n  }\n\n  // Just deduplicate, no filtering\n  const uniqueEmails = [...new Set(allEmails)].filter(email =>\n    !email.includes('.png') &&\n    !email.includes('.jpg') &&\n    !email.includes('.svg') &&\n    !email.includes('.gif') &&\n    !email.includes('.css') &&\n    !email.includes('.js') &&\n    email.length < 80\n  );\n\n  results.push({\n    json: {\n      title: item.json.title || '',\n      city: item.json.city || '',\n      phone: item.json.phone || '',\n      website: website,\n      address: item.json.address || '',\n      email: uniqueEmails[0] || null,\n      allEmails: uniqueEmails\n    }\n  });\n}\nreturn results;"
