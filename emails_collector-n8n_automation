        "jsCode": "const body = $input.first().json.body;\n\nconst cities = Array.isArray(body.cities) ? body.cities : [];\nconst keywords = Array.isArray(body.keywords) ? body.keywords : [];\nconst maxResults = parseInt(body.maxResults) || 10;\n\n// Generate all combinations: \"Keyword City\"\nconst searchStrings = [];\n\nfor (const city of cities) {\n  for (const keyword of keywords) {\n    if (keyword && city) {\n      searchStrings.push(`${keyword} ${city}`);\n    }\n  }\n}\n\nif (searchStrings.length === 0) {\n  throw new Error('No valid search combinations generated. Check cities and keywords.');\n}\n\n// Return a single object (not wrapped in an array)\nreturn {\n  json: {\n    searchStringsArray: searchStrings,\n    maxCrawledPlacesPerSearch: maxResults\n  }\n};"
